# ==========================================
# KONFIGURASI TELEVID DIRECT TELEGRAM STREAMER
# ==========================================

# 1. Kredensial Discord Bot (dari https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# (Opsional) Server ID Anda untuk sinkronisasi slash command instan saat testing
DISCORD_GUILD_ID=

# 2. Kredensial Telegram API (dari https://my.telegram.org)
TG_API_ID=36608325
TG_API_HASH=5959d8fbeba4ebc48ce6da42ac8d43c9

# 3. Token Bot Telegram (Dibuat via @BotFather di Telegram)
# PENTING: Masukkan bot Telegram ini ke Channel Anda dan jadikan sebagai ADMIN!
TG_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz

# 4. Port Web Stream Server (Port yang dibuka di server)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# 5. Public Streaming Base URL
# URL publik yang bisa diakses Discord (misal: domain publik Anda atau Cloudflare Tunnel)
# Contoh: https://stream.domainanda.com atau http://node1.kerit.cloud:8080
STREAM_BASE_URL=https://stream.domainanda.com
