# ==========================================
# KONFIGURASI TELEVID DISCORD BOT
# ==========================================

# 1. Kredensial Discord Bot (dari Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# (Opsional) Discord Guild/Server ID untuk sinkronisasi slash command instan saat testing.
# Kosongkan jika ingin sinkronisasi global (membutuhkan waktu hingga 1 jam untuk sinkronisasi global).
DISCORD_GUILD_ID=

# 2. Konfigurasi Teldrive Web & API
# Host Teldrive yang dapat diakses publik via HTTPS
TELDRIVE_API_HOST=https://teldrive.yourdomain.com

# Access Token dari browser cookie 'user-session' setelah login di Web UI Teldrive
TELDRIVE_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Default Telegram Channel ID (angka positif tanpa -100 atau dengan -100)
TELDRIVE_CHANNEL_ID=4483946044

# 3. (Sangat Direkomendasikan) Direct PostgreSQL Teldrive
# Jika bot berada di VPS yang sama dengan database Teldrive atau Supabase,
# isi DATABASE_URL untuk pencarian message_id secara instan (1 ms) tanpa throttling API.
# Contoh: postgresql://postgres:password@postgres:5432/teldrive
DATABASE_URL=

# 4. (Opsional) Format URL Streaming Publik
# Jika Anda mengonfigurasi Caddy/Nginx reverse proxy untuk bypass cookie auth bagi Discord,
# tentukan templatenya di sini. Variabel yang tersedia: {host}, {file_id}, {filename}
# Default: {host}/api/files/{file_id}/content
PUBLIC_STREAM_URL_TEMPLATE={host}/api/files/{file_id}/content
